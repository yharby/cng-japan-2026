{
  "name": "cng-japan-2026",
  "description": "Slidev source for Portolan: An SDI Without Servers at CNG Japan 2026.",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "slidev",
    "build": "slidev build --out dist",
    "preview": "vite preview",
    "export": "node scripts/export.mjs en",
    "export:en": "node scripts/export.mjs en",
    "export:ja": "node scripts/export.mjs ja",
    "export:all": "pnpm export:en && pnpm export:ja",
    "validate": "node scripts/validate-deck.mjs",
    "smoke": "node scripts/smoke.mjs",
    "test": "pnpm validate && pnpm build && pnpm smoke"
  },
  "dependencies": {
    "@iconify-json/lucide": "^1.2.124",
    "@slidev/cli": "52.19.0",
    "@slidev/theme-default": "^0.25.0",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "playwright-chromium": "^1.62.1",
    "vite": "^8.2.1"
  }
}
